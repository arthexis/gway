# Intentionally disabled until release automation is approved.
# Activate by renaming this file to pypi-publish.yml.
# Until then GitHub Actions will not load or execute it.

name: python / Publish to PyPI

on:
  push:
    tags:
      - "v*"
  workflow_dispatch:
    inputs:
      tag:
        description: "Existing v* tag to publish"
        required: true
        type: string

concurrency:
  group: pypi-publish-${{ github.event_name == 'workflow_dispatch' && inputs.tag || github.ref_name }}
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  build:
    name: Build release artifacts
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.meta.outputs.version }}
      tag: ${{ steps.meta.outputs.tag }}
    steps:
      - name: Resolve release tag
        id: ref
        shell: bash
        env:
          MANUAL_TAG: ${{ inputs.tag }}
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            TAG="$MANUAL_TAG"
          else
            TAG="${GITHUB_REF_NAME}"
          fi
          if [[ ! "$TAG" =~ ^v[0-9]+([.][0-9]+){2}([a-zA-Z0-9.+-]*)?$ ]]; then
            echo "Release tag must look like v1.2.3 (got: $TAG)." >&2
            exit 1
          fi
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"

      - uses: actions/checkout@v7
        with:
          ref: refs/tags/${{ steps.ref.outputs.tag }}
          persist-credentials: false
          fetch-depth: 0

      - uses: actions/setup-python@v7
        with:
          python-version: "3.13"
          cache: pip

      - name: Verify tag matches package version
        id: meta
        shell: bash
        env:
          TAG: ${{ steps.ref.outputs.tag }}
        run: |
          VERSION="$(python - <<'PY'
          import tomllib
          with open("pyproject.toml", "rb") as fh:
              print(tomllib.load(fh)["project"]["version"])
          PY
          )"
          if [ "$TAG" != "v$VERSION" ]; then
            echo "Tag/version mismatch: tag=$TAG, pyproject=$VERSION" >&2
            exit 1
          fi
          echo "version=$VERSION" >> "$GITHUB_OUTPUT"
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"

      - name: Install release tooling
        run: python -m pip install --upgrade pip build twine

      - name: Build distributions
        run: python -m build

      - name: Validate distributions
        run: python -m twine check dist/*

      - name: Smoke install wheel
        shell: bash
        run: |
          python -m venv /tmp/gway-pypi-smoke
          /tmp/gway-pypi-smoke/bin/python -m pip install --upgrade pip
          /tmp/gway-pypi-smoke/bin/python -m pip install dist/*.whl
          /tmp/gway-pypi-smoke/bin/python -m pip check
          /tmp/gway-pypi-smoke/bin/python - <<'PY'
          import importlib.metadata
          import gway
          expected = "${{ steps.meta.outputs.version }}"
          installed = importlib.metadata.version("gway")
          assert installed == expected, (installed, expected)
          print(f"gway {installed} import OK")
          PY
          /tmp/gway-pypi-smoke/bin/gway --version

      - name: Upload distributions
        uses: actions/upload-artifact@v7
        with:
          name: gway-dists
          path: dist/
          if-no-files-found: error

  publish:
    name: Publish to PyPI
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: pypi
      url: https://pypi.org/project/gway/
    permissions:
      id-token: write
      contents: read
    steps:
      - name: Download distributions
        uses: actions/download-artifact@v8
        with:
          name: gway-dists
          path: dist/

      - name: Publish distributions
        uses: pypa/gh-action-pypi-publish@release/v1
        with:
          attestations: true
