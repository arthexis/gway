# Inspect the current node through bounded read-only observations.
#
# Returns node, health, services, deployment, release, queue, Wire,
# and recent-error sections permitted by the caller's effective authority.
# Unsupported authorized capabilities degrade independently instead of
# aborting the whole snapshot.

observe --section node -- node
observe --section services -- service statuses
observe --section deploy -- node deploy status
observe --section release -- node release status
observe --section queue -- node queue status
observe --section wire -- wire check
observe --section errors -- log search "ERROR|CRITICAL" --all --limit 20
observation collect node services deploy release queue wire errors --changed-at null --cursor null
