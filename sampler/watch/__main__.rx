# Inspect the current node through bounded read-only observations.
#
# Returns node, health, services, deployment, release, queue, Wire,
# and recent-error sections permitted by the caller's effective authority.
# Unsupported authorized capabilities degrade independently instead of
# aborting the whole snapshot.

observation validate --changed [changed] --cursor [cursor]
default --watch-errors-filter [errors]
observe --section node --scope [scope] -- node
observe --section services --scope [scope] -- service statuses
observe --section deploy --scope [scope] -- node deploy status
observe --section release --scope [scope] -- node release status
observe --section queue --scope [scope] -- node queue status
observe --section wire --scope [scope] -- wire check
observe --section errors --scope [scope] -- log search "ERROR|CRITICAL" --all --limit 20 --since [since]
observation collect node services deploy release queue wire errors --only [only] --except [except_] --errors [watch_errors_filter] --changed [changed] --cursor [cursor] --published --scope [scope]
