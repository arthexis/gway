setup app --topic remote.browser --templates templates
view --static templates/remote.css --route /remote.css --content-type text/css
view index --route / --template index.html
view login
view privacy --template privacy.html
view connect --method GET --template connect.html
view connect --method POST
view consent --method GET --template consent.html
view consent --method POST
view connections --route /settings/connections --method GET --template connections.html
view connections --route /settings/connections --method POST
