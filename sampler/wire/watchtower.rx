# Converge the Watchtower as the central Wire server and public enrollment endpoint.
default
--domain register.arthexis.com
--host 127.0.0.1
--port 8787
--site register-arthexis-com
--config /etc/wireguard/gway.conf
--server-endpoint vpn.arthexis.com:51820

wire server deploy
--domain [domain]
--interface [interface|gway]
--address [address|10.90.0.1/24]
--listen-port [listen_port|51820]
--config [config]
--public-address [public_address]
--dns-zone [dns_zone|arthexis.com]
--dns-backend [dns_backend|godaddy]
--sudo
--rollback wire-watchtower

wire server activate [interface|gway]
--config [config]

commit wire-watchtower

service install
--backend systemd
--name wire-enroll
--system
-- wire server serve
--host [host]
--port [port]
--domain [domain]
--config [config]
--server-endpoint [server_endpoint]

service start
--name wire-enroll
--system
-- wire server serve
--host [host]
--port [port]
--domain [domain]
--config [config]
--server-endpoint [server_endpoint]

../web/expose/expose
--site [site]
--domain [domain]
--host [host]
--port [port]
--email [email]

wire server check
--domain [domain]
--interface [interface|gway]
--public-address [public_address]
--dns-zone [dns_zone|arthexis.com]
--dns-backend [dns_backend|godaddy]
